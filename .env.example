# Twenty CRM connection.
#
# Copy to .env.local (gitignored) and fill in real values.
# Both are server-only — do NOT prefix them with NEXT_PUBLIC_, since the API
# key grants full read/write access to the workspace.

# Base URL of the Twenty instance, no trailing slash.
# e.g. https://crm.example.com  or  http://198.51.100.42:3000
TWENTY_BASE_URL=

# Workspace API key, from Twenty: Settings -> APIs & Webhooks -> Create API key.
# Twenty shows this value only once, at creation time.
TWENTY_API_KEY=

# Optional. Custom SELECT field on Person holding the lead's pipeline stage.
# Defaults to leadStatus. Twenty has no such field as standard, so the app
# probes the workspace once and, where the field is absent, hides the status
# control and never writes the field. Status then reads as absent, not as a
# guessed value.
TWENTY_LEAD_STATUS_FIELD=
